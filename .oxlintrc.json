{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-eval": "error",
    "no-new-func": "error",
    "no-throw-literal": "error",
    "no-underscore-dangle": [
      "warn",
      {
        "allow": [
          "_npmUser",
          "_authToken",
          "_auth",
          "_id"
        ]
      }
    ]
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/fixtures/**"
  ]
}
