{
  "name": "@depward/analyzer",
  "version": "0.0.0",
  "description": "Static capability and risk-signal extraction from npm package tarballs. Never runs package code.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lavitsamson/depward.git",
    "directory": "packages/analyzer"
  },
  "homepage": "https://github.com/lavitsamson/depward/tree/main/packages/analyzer#readme",
  "bugs": "https://github.com/lavitsamson/depward/issues",
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@depward/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "check:publish": "publint --strict && attw --pack . --profile esm-only"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@depward/core": "workspace:*",
    "acorn": "8.19.0",
    "acorn-walk": "8.3.5"
  }
}
