          "ruleIndex": 3,
          "level": "warning",
          "message": {
            "text": "@scope/native@2.0.0: runs install scripts (install).\n- package.json \"node-gyp rebuild\" install"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "package.json"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
