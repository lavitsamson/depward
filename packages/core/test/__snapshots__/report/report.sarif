        {
          "ruleId": "minified-only",
          "ruleIndex": 4,
          "level": "note",
          "message": {
            "text": "plain: ships only minified code.\n- 2 JS file(s), all minified"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "package.json"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "partialFingerprints": {
            "primaryLocationLineHash": "22564fdc2e854b39:1"
