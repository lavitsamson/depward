          },
          "properties": {
            "severity": "medium",
            "package": "@scope/native",
            "version": "2.0.0"
          }
        },
        {
          "ruleId": "hardcoded-endpoint",
          "ruleIndex": 2,
          "level": "note",
          "message": {
            "text": "evil-pkg@1.0.1: contains hardcoded network endpoints.\n- index.js:3 \"https://collect.example.invalid/e\""
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "package.json"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
