{
  "name": "@depward/core",
  "version": "0.0.0",
  "description": "Registry client, tarball reader, lockfile parsers, cache, config, and reporters for depward.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lavitsamson/depward.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/lavitsamson/depward/tree/main/packages/core#readme",
  "bugs": "https://github.com/lavitsamson/depward/issues",
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@depward/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "check:publish": "publint --strict && attw --pack . --profile esm-only"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
