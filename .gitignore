node_modules/
dist/
coverage/
*.tgz
# Test fixtures are synthetic, inert tarballs and must be committed.
!fixtures/**/*.tgz
# Fixture packages ship their own dist/ folders.
!**/fixtures/**/dist/
# The GitHub Action runs from its committed bundle.
!action/dist/
*.log
.DS_Store
# The M4.0 spike's fixture app ships synthetic packages in node_modules/.
!spikes/**/node_modules/
!spikes/**/dist/
# The caps runtime tests run a synthetic fixture app with its own node_modules/.
!packages/caps/test/fixtures/**/node_modules/
!packages/caps/test/fixtures/**/dist/
