{
  "name": "depward-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.7.0",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "build": "pnpm --recursive --filter \"./packages/*\" run build",
    "test": "vitest run --project unit",
    "test:live": "vitest run --project live",
    "lint": "oxlint --deny-warnings && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tools.json",
    "check:publish": "pnpm --recursive --filter \"./packages/*\" run check:publish",
    "depward": "node --conditions=@depward/source packages/cli/src/bin.ts",
    "bench:gate": "node --conditions=@depward/source scripts/bench-gate.ts",
    "bench:fp": "node --conditions=@depward/source scripts/bench-fp.ts",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-versions.ts",
    "release": "pnpm build && changeset publish",
    "bench:diff": "node --conditions=@depward/source scripts/bench-diff.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@types/node": "22.20.5",
    "@types/semver": "7.8.0",
    "ajv": "8.20.0",
    "ajv-draft-04": "1.0.0",
    "oxlint": "1.89.0",
    "publint": "0.3.25",
    "tsdown": "0.23.2",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
